# Copy to .env and fill in. .env is gitignored; this template is committed.

# HuggingFace - model + dataset access (Qwen/Qwen3.5-0.8B, nikhitrivedi1/nn_ocr4)
HF_TOKEN=

# GPU SKU to probe on - match prod training hardware
MODAL_GPU=H100

# Modal auth — easiest: run `modal setup` once → ~/.modal.toml (read automatically, no loader).
# The env vars below are the alternative for unattended/CI on a fresh machine; set them from a
# secret store, never commit real tokens. Leave them UNSET if using the toml path (empty
# values would override the toml and break auth).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Legacy Paperspace VM — kept during migration, remove after cutover (Phase 6).
PAPERSPACE_PASSWORD=
