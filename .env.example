# Copy to .env and fill in. .env is gitignored; this template is committed.
# SECRETS ONLY — the run spec (model, dataset, gpu, scan) lives in run.toml (see run.toml.example).

# HuggingFace token — model/dataset access (both backends; forwarded to the SSH VM).
HF_TOKEN=

# SSH VM auth — set ONE (the rest of the SSH connection lives in run.toml [ssh]).
AUTOTUNE_SSH_PASSWORD=              # password auth (Paperspace)
AUTOTUNE_SSH_KEY=                   # path to a private key (Lambda Labs)

# Modal auth — normally `modal setup` writes ~/.modal.toml (read automatically). These are the
# unattended/CI alternative; leave UNSET if using the toml path (empty values break auth).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
