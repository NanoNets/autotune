# Copy to .env and fill in. .env is gitignored; this template is committed.

# ── Backend selection ─────────────────────────────────────────────────────────
# Where the probe runs. Same pipeline + same metrics either way.
#   modal       — Modal serverless GPU (default)
#   ssh         — an SSH GPU VM; paperspace / lambda are accepted aliases
AUTOTUNE_BACKEND=modal

# HuggingFace — model + dataset access (Qwen/Qwen3.5-0.8B, nikhitrivedi1/nn_ocr4).
# Used by both backends (forwarded to the VM on the SSH backend).
HF_TOKEN=

# ── Modal backend (AUTOTUNE_BACKEND=modal) ────────────────────────────────────
# GPU SKU to probe on — match prod training hardware.
MODAL_GPU=H100
# Auth — easiest: run `modal setup` once → ~/.modal.toml (read automatically). The vars below are
# the alternative for unattended/CI; leave UNSET if using the toml path (empty values break auth).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ── SSH VM backend (AUTOTUNE_BACKEND=ssh) ─────────────────────────────────────
# A rented GPU box (Paperspace, Lambda Labs, …). Set HOST + USER and ONE of KEY / PASSWORD.
AUTOTUNE_SSH_HOST=                  # e.g. 184.105.190.154
AUTOTUNE_SSH_USER=                  # e.g. paperspace / ubuntu
AUTOTUNE_SSH_KEY=                   # path to a private key (Lambda Labs)  — or use PASSWORD below
AUTOTUNE_SSH_PASSWORD=              # password auth (Paperspace)            — or use KEY above
AUTOTUNE_SSH_ACTIVATE=             # command to enter the swift env, e.g. 'source ~/envs/swift-env/bin/activate'
AUTOTUNE_REMOTE_DIR=                # default /tmp/autotune
AUTOTUNE_CUDA_VISIBLE_DEVICES=      # default 0

# Legacy Paperspace VM password (pre-AUTOTUNE_SSH_* convention) — remove after cutover.
PAPERSPACE_PASSWORD=
