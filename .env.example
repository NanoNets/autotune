# Copy to .env and fill in. .env is gitignored; this template is committed.
# SECRETS / CONNECTION ONLY. Experiment inputs — backend, model, dataset, max_length,
# effective_batch, hardware, hardware_number — live in config.json, NOT here.

# HuggingFace token. Used by the SSH backend (forwarded to the VM) and local tools.
# (On Modal, HF access comes from a Modal secret instead — see below.)
HF_TOKEN=

# ── Modal backend (config "backend": "modal") ─────────────────────────────────
# Auth — easiest: run `modal setup` once → ~/.modal.toml (read automatically). For headless/CI use
# the two vars below instead; leave them UNSET if using the toml (empty values break auth).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# HF access on Modal comes from a Modal secret, not this file:
#   modal secret create hf-token HF_TOKEN=hf_...
# GPU type + count come from config.json (hardware / hardware_number) — not env.

# ── SSH VM backend (config "backend": "ssh") ──────────────────────────────────
# A rented GPU box (Paperspace, Lambda Labs, …). Set HOST + USER and ONE of KEY / PASSWORD.
AUTOTUNE_SSH_HOST=                  # e.g. 184.105.190.154
AUTOTUNE_SSH_USER=                  # e.g. paperspace / ubuntu
AUTOTUNE_SSH_KEY=                   # path to a private key (Lambda Labs)  — or use PASSWORD below
AUTOTUNE_SSH_PASSWORD=              # password auth (Paperspace)            — or use KEY above
AUTOTUNE_SSH_ACTIVATE=             # command to enter the swift env, e.g. 'source ~/envs/swift-env/bin/activate'
AUTOTUNE_REMOTE_DIR=                # default /tmp/autotune
AUTOTUNE_CUDA_VISIBLE_DEVICES=      # optional override; default 0..N-1 from hardware_number
