# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environments (uv manages .venv)
.venv/
venv/
env/

# Env / secrets
.env
.env.*
!.env.example

# Run config (fill run.toml from the committed run.toml.example template)
run.toml

# Track the repo's Claude Code skills (overrides a global .claude/ ignore)
!.claude/
.claude/settings.local.json

# Local working docs (not shared)
CLAUDE.md
PLAN.md
HANDOFF.md
notes.md
wip_docs/

# Run outputs (keep the dir's README and the plot tool, ignore the run artifacts)
runs/*
!runs/README.md
!runs/progress.py
*.trace.json
*.log

# Editor / IDE
.idea/
.vscode/

# throwaway/dev scripts (live GPU validation harnesses, one-off probes)
tmp_scripts/

# Local parity harness for the bring-your-own-script work: experiments, frozen
# baseline, raw results. Not shipped (see bring_your_own_script.md).
sandbox/
