# run.toml.example — copy to run.toml and fill in. run.toml is gitignored; this template is committed.
#
# The declarative spec for one autotune run: it records the run's inputs for the agent, who passes
# them to Frame (as flags) and to backends (in each probe config). No code reads this file.
# Secrets (HF_TOKEN, Modal/SSH auth) live in .env, not here.

model           = "Qwen/Qwen2.5-0.5B"     # HF hub id or local path
dataset         = "Salesforce/wikitext"   # HF hub id or local path
name            = "wikitext-2-raw-v1"     # dataset config/subset; omit if the dataset has none
gpu             = "A10G"                  # a label for the record; never looked up (the peak is measured on the card)
                                           # single GPU only for now — frame/ has no multi-GPU support yet
effective_batch = 16                      # human-owned target; off-limits, the loop only factorizes it (loop/throughput.md)
max_len         = 2048                    # REQUIRED. the sequence length your application needs.
                                           # human-owned and off-limits like effective_batch, and the
                                           # length the OOM ceiling is measured at (frame/README.md).
                                           # must be <= the model's context length, or Frame refuses.

# Vision-language models only: the image worst case, declared like max_len (frame/README.md).
# max_image_size = "672x672"   # the largest image the training code lets through, W x H pixels
# max_images     = 1           # most images per sample; omit to have Frame scan the data for it

backend = "local"   # "local", "ssh" or "modal" — see backends/README.md
device  = "cuda"    # what the probe runs ON. "cuda" for any GPU box; single-GPU only, so no
                    # "cuda:0". "cpu" is a smoke test — a well-formed Observation whose MFU is
                    # meaningless — so ask for it deliberately. Delete this line to auto-detect
                    # (cuda when present, else cpu with a warning); set it to fail loudly instead.

# Bring your own training script (optional; program.md "Script mode"). When set,
# probes run YOUR script unchanged instead of a frameworks/ runner. The path is relative to the repo
# root (the ssh backend runs the same path on the box). script_args are the BASELINE arguments: the
# agent appends a step budget and changes only your script's own flags between probes.
# script_configs (only with script) lists the config file(s) the script loads its settings from;
# omit it when the settings live in the script itself (flags or hardcoded). The agent never edits
# these files: each probe gets its own copy under runs/<run>/probes/.
# script         = "runs/my_run/train.py"
# script_configs = ["runs/my_run/train.yaml"]
# script_args    = ["--config", "runs/my_run/train.yaml"]

[scan]
text_field = "text"    # which dataset column to tokenize
split      = "train"   # dataset split to scan
sample     = 1000      # probe sample size: rows drawn length-stratified from a random pool
                       # (20x this) by Frame, rounded down to a multiple of effective_batch.
                       # Written to runs/<run>/sample.jsonl; every probe loads it (sample_file)

[ceiling]
seed = 0               # seed for the synthetic max_len batches, so a ceiling is reproducible

# only used when backend = "ssh" — the SSH credential itself (AUTOTUNE_SSH_PASSWORD /
# AUTOTUNE_SSH_KEY) stays in .env, never here. Optional keys: python, remote_dir, sync
# (defaults and meaning in backends/README.md)
[ssh]
host = ""
user = ""

# (later) the loop adds objective + budget here.
